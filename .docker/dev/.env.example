# postgres major version
DB_VERSION=16
# project/stack name (used by Makefile and compose project name)
COMPOSE_PROJECT_NAME=woodglass_affine_dev
# database credentials
DB_PASSWORD=affine
DB_USERNAME=affine
DB_DATABASE_NAME=affine

# host port mappings (to avoid conflicts)
DB_PORT=55432
REDIS_PORT=56379
MAILHOG_SMTP_PORT=51025
MAILHOG_WEB_PORT=58025
MANTICORE_PORT=59308

# elasticsearch env
# ELASTIC_VERSION=9.0.1
# enable for arm64, e.g.: macOS M1+
# ELASTIC_VERSION_ARM64=-arm64
# ELASTIC_PLATFORM=linux/arm64

# manticoresearch
MANTICORE_VERSION=10.1.0
